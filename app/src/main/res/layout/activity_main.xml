<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Заголовок -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Как вы себя чувствуете?"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <!-- Блок с оценкой настроения -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Оценка настроения:"
        android:textSize="18sp"
        android:layout_marginBottom="8dp" />

    <!-- Контейнер для смайлов -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <ImageView
            android:id="@+id/mood1"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:src="@android:drawable/btn_star_big_off"
            android:contentDescription="Настроение 1"
            android:padding="8dp" />

        <ImageView
            android:id="@+id/mood2"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:src="@android:drawable/btn_star_big_off"
            android:contentDescription="Настроение 2"
            android:padding="8dp" />

        <ImageView
            android:id="@+id/mood3"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:src="@android:drawable/btn_star_big_off"
            android:contentDescription="Настроение 3"
            android:padding="8dp" />

        <ImageView
            android:id="@+id/mood4"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:src="@android:drawable/btn_star_big_off"
            android:contentDescription="Настроение 4"
            android:padding="8dp" />

        <ImageView
            android:id="@+id/mood5"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:src="@android:drawable/btn_star_big_off"
            android:contentDescription="Настроение 5"
            android:padding="8dp" />

    </LinearLayout>
    <!-- Поле для комментария -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Комментарий:"
        android:textSize="18sp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/commentEditText"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:inputType="textMultiLine"
        android:gravity="top|start"
        android:padding="12dp"
        android:hint="Введите ваш комментарий здесь..."
        android:background="@android:drawable/editbox_background"
        android:layout_marginBottom="24dp" />

    <!-- Горизонтальный контейнер для кнопок -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/clearButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Очистить"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#FF4433" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Сохранить"
            android:layout_marginStart="4dp"
            android:backgroundTint="#4CAF50" />

    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CCCCCC"
        android:layout_marginVertical="16dp" />

    <!-- Заголовок статистики -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Статистика за неделю"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Таблица статистики -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Пн"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="8dp"
            android:background="#E0E0E0" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Вт"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="8dp"
            android:background="#E0E0E0" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ср"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="8dp"
            android:background="#E0E0E0" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Чт"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="8dp"
            android:background="#E0E0E0" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Пт"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="8dp"
            android:background="#E0E0E0" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Сб"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="8dp"
            android:background="#E0E0E0" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Вс"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="8dp"
            android:background="#E0E0E0" />

    </LinearLayout>

    <!-- Значения статистики с цветовой индикацией -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <!-- Понедельник (4) - синий -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="4"
            android:textSize="16sp"
            android:gravity="center"
            android:padding="12dp"
            android:background="#2196F3"
            android:textColor="#FFFFFF" />

        <!-- Вторник (3) - зеленый -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="3"
            android:textSize="16sp"
            android:gravity="center"
            android:padding="12dp"
            android:background="#4CAF50"
            android:textColor="#FFFFFF" />

        <!-- Среда (5) - оранжевый -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="5"
            android:textSize="16sp"
            android:gravity="center"
            android:padding="12dp"
            android:background="#FF9800"
            android:textColor="#FFFFFF" />

        <!-- Четверг (2) - желтый -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2"
            android:textSize="16sp"
            android:gravity="center"
            android:padding="12dp"
            android:background="#FFEB3B"
            android:textColor="#000000" />

        <!-- Пятница (4) - синий -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="4"
            android:textSize="16sp"
            android:gravity="center"
            android:padding="12dp"
            android:background="#2196F3"
            android:textColor="#FFFFFF" />

        <!-- Суббота (5) - оранжевый -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="5"
            android:textSize="16sp"
            android:gravity="center"
            android:padding="12dp"
            android:background="#FF9800"
            android:textColor="#FFFFFF" />

        <!-- Воскресенье (4) - синий -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="4"
            android:textSize="16sp"
            android:gravity="center"
            android:padding="12dp"
            android:background="#2196F3"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <!-- Подпись к статистике -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Цвет показывает оценку настроения (1-5)"
        android:textSize="14sp"
        android:textColor="#666666"
        android:gravity="center" />
</LinearLayout>